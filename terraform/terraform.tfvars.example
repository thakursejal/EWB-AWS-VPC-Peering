
# AWS Region for the EWB VPC Peering project
aws_region = "ap-south-1"

# EC2 instance size
instance_type = "t3.micro"

# Replace with your own current public IPv4 address followed by /32
admin_ip_cidr = "REPLACE_WITH_YOUR_PUBLIC_IP/32"

# Replace with your SSH public key (not your private key)
ssh_public_key = "REPLACE_WITH_YOUR_SSH_PUBLIC_KEY"
