aws_region    = "ap-south-1"
instance_type = "t3.micro"

# Replace with the administrator's public IPv4 address.
# Use a single address with /32 notation.
admin_ip_cidr = "203.0.113.10/32"

# Replace with the contents of your SSH public key.
# Never put a private SSH key in this file.
ssh_public_key = "ssh-ed25519 AAAA_REPLACE_WITH_YOUR_PUBLIC_KEY"
